# Copy to .env for Docker Compose (never commit credentials).
# Docker HTTP port is fixed at 8765 (PORT affects only the local Python launcher).
# Set 0.0.0.0 for LAN access; default is host-local.
ATLAS_BIND=127.0.0.1
ATLAS_DATA_DIR=./data
ATLAS_IMAGE_TAG=local
# run.sh fills these from the host when unset. Direct compose defaults to 1000.
# ATLAS_UID=1000
# ATLAS_GID=1000
# MASSIVE_API_KEY=

# Optional trusted same-origin Wiki UI through a local reverse proxy.
# Chat remains localhost-only. Comma-separated full origins; no wildcard.
# NEWS_ATLAS_WIKI_ORIGINS=https://your-trusted-host:8765
